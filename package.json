{
  "name": "scde-mod-manager",
  "version": "0.2.10",
  "description": "Safe, profile-based mod manager for Stronghold Crusader: Definitive Edition",
  "main": "src/main.js",
  "author": "SCDE Mod Manager contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test --experimental-test-isolation=none test/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "adm-zip": "0.6.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "42.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.scde.modmanager",
    "productName": "SCDE Mod Manager",
    "asar": true,
    "beforePack": "tools/prepare-bundled-se.js",
    "portable": {
      "unpackDirName": true
    },
    "files": [
      "src/**/*",
      "ICON/SCDEMM.ico",
      "package.json",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "release/se-update-helper",
        "to": "se-update-helper"
      },
      {
        "from": "release/bepinex-runtime-5.4.23.5.scdemod",
        "to": "system-mods/bepinex-runtime-5.4.23.5.scdemod"
      },
      {
        "from": "release/scde-multiplayer-compatibility-0.4.0.scdemod",
        "to": "system-mods/scde-multiplayer-compatibility-0.4.0.scdemod"
      },
      {
        "from": "release/bundled-se",
        "to": "system-mods/bundled-se"
      }
    ],
    "win": {
      "icon": "ICON/SCDEMM.ico",
      "target": [
        "portable"
      ],
      "artifactName": "SCDE-Mod-Manager-Portable.${ext}"
    }
  }
}
